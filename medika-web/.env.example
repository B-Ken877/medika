# Medika Web — environment placeholders only. Copy to .env.local and fill in.
# NEVER commit real credentials, tokens, or secrets.

# Base URL of the Medika backend REST API (no trailing slash).
# Empty string = same origin, relying on the nginx /api proxy (production setup)
# or the Next.js dev rewrites (local development).
NEXT_PUBLIC_API_BASE_URL=

# Base URL of the MonCash payment server (no trailing slash).
# Empty string = same origin (/payment is proxied by nginx in production).
NEXT_PUBLIC_PAYMENT_BASE_URL=

# WebSocket endpoint of the Medika realtime channel.
# Empty = same origin /ws (production: nginx routes /ws to the backend).
# Local development needs the backend origin because Next.js rewrites
# cannot proxy WebSocket upgrades: ws://localhost:3000/ws
NEXT_PUBLIC_WS_URL=

# Local development only: origins used by next.config.mjs rewrites to proxy
# /api, /uploads and /payment during `npm run dev`.
DEV_BACKEND_ORIGIN=http://localhost:3000
DEV_PAYMENT_ORIGIN=http://localhost:9998

# ─── Vercel deployment (build-time) ──────────────────────────────────────────
# Origin of the medika-api Vercel project (backend). When set at BUILD time,
# next.config.mjs proxies /api, /payment and /uploads through this app so the
# browser stays same-origin.
# API_ORIGIN=https://medika-api.your-team.vercel.app

# WebSocket endpoint — CANNOT be proxied by Next.js rewrites. Point it at the
# API project origin (or the standalone realtime host):
# NEXT_PUBLIC_WS_URL=wss://medika-api.your-team.vercel.app/ws
