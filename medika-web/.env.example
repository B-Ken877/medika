# Medika Web — environment placeholders only. Copy to .env.local and fill in.
# NEVER commit real credentials, tokens, or secrets.

# Base URL of the Medika backend REST API (no trailing slash).
# Empty string = same origin: in production the Vercel project routes /api/*
# to the api service (see the repository-root vercel.json); in local
# development the Next.js dev rewrites below proxy it.
NEXT_PUBLIC_API_BASE_URL=

# Base URL of the MonCash payment server (no trailing slash).
# Empty string = same origin (/payment is routed by the platform / dev proxy).
NEXT_PUBLIC_PAYMENT_BASE_URL=

# WebSocket endpoint of the Medika realtime channel.
# Empty = same origin /ws (production: the platform routes the /ws upgrade to
# the api service). Local development needs the backend origin because the
# Next.js rewrites cannot proxy WebSocket upgrades: ws://localhost:3000/ws
NEXT_PUBLIC_WS_URL=

# Local development only: origins used by next.config.mjs rewrites to proxy
# /api, /uploads and /payment during `npm run dev`.
DEV_BACKEND_ORIGIN=http://localhost:3000
DEV_PAYMENT_ORIGIN=http://localhost:9998

# ─── Production (Vercel) ─────────────────────────────────────────────────────
# No build-time variables are needed: the app is deployed as the `web` service
# of the single Medika Vercel project (Vercel Services). The browser calls
# /api, /payment, /uploads with same-origin relative URLs and the platform
# router sends them to the api service; /ws defaults to wss://<host>/ws.
# NEXT_PUBLIC_WS_URL remains the only override (e.g. to point at the
# standalone realtime/server.js host instead of the Vercel WS beta).
