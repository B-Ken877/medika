# Medika Backend — environment variables (placeholders only, NEVER real values).
# Copy to .env (gitignored) for local development; configure the same keys in
# Vercel Project → Settings → Environment Variables for deployments.

# ─── Required in production ──────────────────────────────────────────────────
# PostgreSQL connection string (managed provider: Neon / Supabase / RDS…).
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Secret used to sign JWT bearer tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be >= 32 chars in production (the server refuses to boot otherwise).
JWT_SECRET=

# ZEGOCLOUD video consultations (sole provider).
# App ID and Server URL are client-visible; secrets remain server-only.
# Tokens are minted on the server. Never commit real credentials.
ZEGOCLOUD_APP_ID=
# Public engine endpoint from the ZEGO console (wss://…); visible to clients.
ZEGOCLOUD_SERVER_URL=
# Backend only; exactly 32 chars; used for server-side token04 minting.
ZEGOCLOUD_SERVER_SECRET=
# Backend only; NOT used by token04 auth; must never reach client bundles.
ZEGOCLOUD_APP_SIGN=

# ─── MonCash payments (Digicel) ──────────────────────────────────────────────
# 'sandbox' or 'production'. Credentials come from the MonCash business portal.
MONCASH_MODE=sandbox
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=

# Reject consultation creation without a VERIFIED payment.
# Defaults to true in production; set to false only for staging/demo WITHOUT
# MonCash credentials (consultations then become free — do not use in prod).
REQUIRE_PAYMENT=

# Explicitly enable simulated (test) payments — the full consultation flow
# runs without a real MonCash transaction. FAILS CLOSED on production:
#   - VERCEL_ENV=production  → the server REFUSES TO BOOT
#   - NODE_ENV=production without VERCEL_ENV (legacy VPS) → REFUSES TO BOOT
#   - unknown VERCEL_ENV values → treated as production (simulation disabled)
# Authorized targets: local dev, `vercel dev`, and Vercel PREVIEW deployments
# (VERCEL_ENV=preview — previews build with NODE_ENV=production, so VERCEL_ENV
# is the authoritative stage signal). Also requires MONCASH_MODE != production.
# On Vercel, set it in Project → Settings → Environment Variables with the
# "Preview" scope ONLY. To restore the ordinary MonCash flow: unset it.
PAYMENT_SIMULATION=false

# ─── Uploads (Vercel Blob) ───────────────────────────────────────────────────
# Token from Vercel → Storage → Blob (needed for /api/upload in production).
# The store's access mode is PRIVATE: EVERYTHING is written with
# access:'private' (a public put is rejected by the store with BlobError).
#  - Consultation medical media → participant-authorized short-lived signed
#    URLs (routes/consultations.js); the token NEVER reaches the browser.
#  - Shared avatar-class assets (POST /api/upload) → capability URLs served
#    by GET /api/media/assets/<id>.<ext> (routes/media.js).
# Requires @vercel/blob >= 2.x (installed).
BLOB_READ_WRITE_TOKEN=

# During migration: origin that still serves the legacy /uploads files
# (e.g. https://medikahaiti.site). /uploads/* requests 302-redirect there.
LEGACY_UPLOADS_ORIGIN=

# Upload size cap in MB (Vercel Functions hard limit is 4.5MB request bodies).
MAX_UPLOAD_MB=4

# Development-only disk fallback for uploads when no Blob token is configured.
LOCAL_UPLOADS_DIR=

# ─── Realtime (optional cross-instance WS fan-out) ───────────────────────────
# Redis (e.g. Upstash via the Vercel Marketplace). Without it, WebSocket
# delivery and participant PRESENCE are single-function-instance (fine for
# dev and small deployments). With it: message fan-out across instances AND
# multi-instance presence via expiring per-connection leases (a crashed
# instance's presence self-expires within ~65s).
REDIS_URL=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API cross-origin.
# Native Android clients are always allowed (no Origin header).
CORS_ORIGINS=

# ─── Seeding (scripts/migrate.js) ────────────────────────────────────────────
# Initial admin account (only applied when no admin exists).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Development demo data (refuses to boot in production). Seeds one doctor and
# one patient with DEMO_PASSWORD so the full flow is testable locally.
SEED_DEMO=false
DEMO_PASSWORD=

# ─── Tunables ────────────────────────────────────────────────────────────────
# JWT lifetime in days (default 30).
JWT_EXPIRES_DAYS=30
# Platform fee per completed consultation, in HTG (legacy value 250).
# Snapshotted into each doctor_earnings row when it is created, so changing
# it never rewrites historical earnings or paid-out cycles.
PLATFORM_FEE=250
# Force DATABASE_SSL true/false (auto-detected from the URL by default).
DATABASE_SSL=
# Server port for standalone mode (Vercel ignores this).
PORT=3000

# ─── Consultation request lifecycle (issue #25) ──────────────────────────────
# Doctor acceptance window per offer (product default: 60 minutes) and the
# consultation expiry after acceptance (product default: 5 hours). Deadlines
# are server-authoritative (database clock); expired offers are rerouted to
# the next eligible available doctor automatically.
OFFER_WINDOW_MINUTES=60
CONSULTATION_EXPIRY_HOURS=5
# Cooldown before a pool-exhausted request re-scans for newly available
# doctors (waiting state — never a hot retry loop).
REROUTE_RETRY_MINUTES=15

# Shared secret protecting /api/crons/consultation-deadlines (the scheduled
# deadline processor). When set, callers must send
# `Authorization: Bearer <CRON_SECRET>` — the GitHub Actions workflow
# (.github/workflows/consultation-deadlines.yml) does this automatically.
# When unset, the endpoint only accepts Vercel's x-vercel-cron marker or an
# admin JWT. Generate with:  openssl rand -hex 32
CRON_SECRET=

# ─── Web Push notifications (issue #36) ───────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# The PRIVATE key stays server-side (never in a client bundle); clients fetch
# the public key from GET /api/notifications/vapid-public-key.
# With these unset, push delivery is safely disabled: the outbox keeps rows
# queued and in-app notifications continue to work (rollout switch).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@medika.ht
