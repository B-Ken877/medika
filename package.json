{
  "name": "medika-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Medika backend — Express REST API + realtime WebSocket, deployable to Vercel as a single Function",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node scripts/migrate.js",
    "seed-doctors": "node scripts/seed-doctors.js",
    "import-json": "node scripts/import-json-data.js",
    "smoke-verify": "node scripts/smoke-verify.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.9.1",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.13.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.5.0-beta.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.5.0-beta.15": true,
    "esbuild@0.21.5": true
  }
}
